@page "/lifecycle/product"
@using homework.Models.DTOS.LifeCycleProductDtos;

@inject HttpClient _http;
@inject NavigationManager _nav;


<PageTitle>Product</PageTitle>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Danh sách sản phẩm</h2>
            <p class="text-muted mb-0">
                Khám phá các sản phẩm của chúng tôi
            </p>
        </div>

        <span class="badge bg-primary fs-6">
            Tổng cộng: @ProductResponse.Total sản phẩm
        </span>
    </div>

    <!-- Search + Filter -->
    <div class="row mb-4">
        <div class="col-md-6">
            <input type="text" class="form-control" placeholder="Tìm kiếm sản phẩm..." />
        </div>

        <div class="col-md-3">
            <select class="form-select">
                <option value="">Tất cả danh mục</option>
                @foreach (var category in lstProduct.Select(item => item.Category).Distinct())
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <select class="form-select">
                <option value="">Sắp xếp</option>
                <option value="price-asc">Giá thấp → cao</option>
                <option value="price-desc">Giá cao → thấp</option>
                <option value="rating">Đánh giá</option>
            </select>
        </div>

    </div>


    <!-- Product List -->
    <div class="row">
        <!-- Product -->
        @foreach (var item in lstProduct)
        {
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="position-relative">
                        <img src="@item.Thumbnail" class="card-img-top" style="height:220px; object-fit:contain;"
                             alt="@item.Title" />
                        <span class="badge bg-danger position-absolute top-0 end-0 m-2">
                            @(item.DiscountPercentage > 0 ? $"-{item.DiscountPercentage}%" : "")
                        </span>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <span class="text-muted small mb-1">
                            @item.Category
                        </span>
                        <h5 class="card-title">
                            @item.Title
                        </h5>
                        <p class="card-text text-muted small">
                            @item.Description
                        </p>
                        <div class="mb-2">
                            <span>⭐ @item.Rating</span>
                            <span class="text-muted">
                                · @item.Stock item
                            </span>
                        </div>
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between
                                align-items-center mb-3">
                                <h5 class="text-danger mb-0">
                                    $@item.Price
                                </h5>
                                <span class="text-success small">
                                    @item.AvailabilityStatus
                                </span>
                            </div>
                            <button @onclick="() => GoToDetail(item.Id)" class="btn btn-primary w-100">
                                Xem chi tiết
                            </button>
                            <button @onclick="() => SelectProduct(item)" class="btn btn-success w-100 mt-3">
                                Xem ảnh
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <Product_ImagePopup Item="product_img" @bind-Show="showPopup" />
    <!-- Pagination -->
    @* <nav class="mt-3">

        <ul class="pagination justify-content-center">

            <li class="page-item disabled">
                <button class="page-link">
                    Trước
                </button>
            </li>

            @for (int i = 1; i < ProductResponse.Total; i++)
            {
                <li class="page-item active">
                    <button class="page-link" @onclick="() => LoadProduct(i)">
                        @i
                    </button>
                </li>
            }

            <li class="page-item">
                <button class="page-link">
                    Sau
                </button>
            </li>

        </ul>

    </nav> *@

</div>

@code {
    private List<ProductDto> lstProduct = new List<ProductDto>();
    private ProductListResponseDto? ProductResponse = new ProductListResponseDto();
    private ProductDto? product_img = new ProductDto();
    private bool showPopup;

    private const int pageSize = 30;
    private int pageNumber;
    private int skip;

    @* hàm load list sản phẩm theo page *@
    public async Task<ProductListResponseDto> LoadProduct(int pageNumber)
    {
        this.pageNumber = pageNumber;
        skip = (pageNumber - 1) * pageSize;
        ProductResponse = await _http.GetFromJsonAsync<ProductListResponseDto>(
            $"https://dummyjson.com/products?limit={pageSize}&skip={skip}");

        lstProduct = ProductResponse?.Products ?? new List<ProductDto>();
        return ProductResponse ?? new ProductListResponseDto();

    }

    @* khỏi tạo mỗi khi component xuất hiện  
        gọi API bên ngoài nên phải dùng async để đợi  *@
    protected override async Task OnInitializedAsync()
    {
        ProductResponse = await LoadProduct(1);
    }

    @* hàm điều hướng trang *@
    private void GoToDetail(int id)
    {
        _nav.NavigateTo($"/lifecycle/product/{id}");
    }

    @* hàm load ảnh sản phẩm *@
    private void SelectProduct(ProductDto item)
    {
        product_img = item;
        showPopup = true;
    }

}