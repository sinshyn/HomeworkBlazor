@page "/lifecycle/assignment/user-manage"
@using homework.Models.DTOS.UserDtos
@using homework.Services
@inject IUserService UserService
@inject IJSRuntime JS
<PageTitle>Quản lý Người Dùng</PageTitle>


<div class="container text-center ">
    <h1 class="text-success mt-3">Quản lý Người Dùng</h1>
    @* userform *@
    <UserForm AddUser="SaveUserAsync" UserInfo="@InfoUser" />

    @* userlist *@
    <UserList Users="@lstUser" EditUser="EditInfo" DeleteUser="RemoveUserAsync" />
</div>

@code {
    private UserDto? InfoUser;
    private List<UserDto> lstUser = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            lstUser = await UserService.GetAllAsync();
        }
        catch (Exception ex)
        {
            await Error(ex.Message);
        }
    }

    // THÊM / SỬA
    private async Task SaveUserAsync(UserDto newUser)
    {
        try
        {
            bool isEdit = InfoUser != null && InfoUser.Id == newUser.Id;

            if (isEdit)
            {
                await UserService.UpdateAsync(newUser);
                var index = lstUser.FindIndex(u => u.Id == newUser.Id);
                if (index >= 0) lstUser[index] = newUser;
                await Success("Đã cập nhật người dùng");
            }
            else
            {
                await UserService.AddAsync(newUser);
                newUser.Id = lstUser.Any() ? lstUser.Max(u => u.Id) + 1 : 1;
                lstUser.Add(newUser);
                await Success("Đã thêm người dùng mới");
            }

            InfoUser = null; // thoát chế độ sửa
        }
        catch (Exception ex)
        {
            await Error(ex.Message);
        }
    }

    private void EditInfo(UserDto user)
    {
        InfoUser = user;
    }

    // XÓA
    private async Task RemoveUserAsync(int id)
    {
        bool ok = await JS.InvokeAsync<bool>("showConfirm", "Bạn chắc chắn?", "Người dùng này sẽ bị xóa");
        if (!ok) return;

        try
        {
            await UserService.DeleteAsync(id);
            lstUser.RemoveAll(u => u.Id == id);
            await Success("Đã xóa người dùng");
        }
        catch (Exception ex)
        {
            await Error(ex.Message);
        }
    }

    // Thông báo
    private Task Success(string text) =>
        JS.InvokeVoidAsync("showAlert", "Thành công", text, "success").AsTask();

    private Task Error(string text) =>
        JS.InvokeVoidAsync("showAlert", "Thất bại", text, "error").AsTask();
}

@* 
