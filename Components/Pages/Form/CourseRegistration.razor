@page "/form/course-registration-form"
@inject IJSRuntime JS

<PageTitle>Course Registration Form</PageTitle>

<div class="container">
    <div class="mx-auto py-4 bg-info-subtle">
        <div class="row">
            <div class="col-8">
                <h1 class="text-center">Course Registration Form</h1>
                <EditForm EditContext="@editContext" class="px-5 row g-3" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                    <DataAnnotationsValidator />

                    <div class="col-md-12">
                        <label for="fullName" class="form-label">Full Name *</label>
                        <input @bind="@regisModel.FullName" @bind:event="oninput" type="text"
                               class="form-control @(GetFieldClass("FullName"))"
                               id="fullName" placeholder="Enter your full name" />
                        <ValidationMessage For="@(() => regisModel.FullName)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <label for="email" class="form-label">Email *</label>
                        <input @bind="@regisModel.Email" @bind:event="oninput" type="email"
                               class="form-control @(GetFieldClass("Email"))"
                               id="email" placeholder="Enter your email" />
                        <ValidationMessage For="@(() => regisModel.Email)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <label for="phone" class="form-label">Phone Number *</label>
                        <input @bind="@regisModel.Phone" @bind:event="oninput" type="tel"
                               class="form-control @(GetFieldClass("Phone"))"
                               id="phone" placeholder="Enter your phone number" />
                        <ValidationMessage For="@(() => regisModel.Phone)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <label for="address" class="form-label">Address</label>
                        <input @bind="@regisModel.Address" @bind:event="oninput" type="text"
                               class="form-control @(GetFieldClass("Address"))"
                               id="address" placeholder="Enter your address" />
                        <ValidationMessage For="@(() => regisModel.Address)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <label for="message" class="form-label">Message *</label>
                        <textarea @bind="@regisModel.Message" @bind:event="oninput"
                                  class="form-control @(GetFieldClass("Message"))"
                                  id="message" rows="5" placeholder="Enter your message"></textarea>
                        <ValidationMessage For="@(() => regisModel.Message)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <label for="service" class="form-label">Select Service *</label>
                        <select @bind="@regisModel.Service"
                                class="form-select @(GetFieldClass("Service"))"
                                name="service" id="service">
                            <option value="">Chọn dịch vụ</option>
                            <option value="Mua sắm">Mua sắm</option>
                            <option value="Đi ăn">Đi ăn</option>
                            <option value="Du lịch">Du lịch</option>
                            <option value="Đặt phòng">Đặt phòng</option>
                            <option value="Đặt xe">Đặt xe</option>
                            <option value="Thuê xe tự lái">Thuê xe tự lái</option>
                        </select>
                        <ValidationMessage For="@(() => regisModel.Service)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <div class="form-check">
                            <input @bind="regisModel.TermsAccepted"
                                   class="form-check-input @(GetFieldClass("TermsAccepted"))"
                                   type="checkbox" id="terms" />
                            <label class="form-check-label" for="terms">
                                I accept the Terms and Conditions *
                            </label>
                        </div>
                        <ValidationMessage For="@(() => regisModel.TermsAccepted)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                </EditForm>
            </div>

            <div class="col-4">
                <h2>Thông tin ghi nhận</h2>
                <p>Họ tên: @regisModel.FullName</p>
                <p>Email: @regisModel.Email</p>
                <p>Số điện thoại: @regisModel.Phone</p>
                <p>Địa chỉ: @regisModel.Address</p>
                <p>Dịch vụ: @regisModel.Service</p>
                <p>Lời nhắn: @regisModel.Message</p>
                <p>Đồng ý điều khoản: @(regisModel.TermsAccepted ? "✅ Có" : "❌ Chưa")</p>
            </div>
        </div>
    </div>
</div>

@code {
    private RegistorVM regisModel = new RegistorVM();
    private EditContext? editContext;
    private ValidationMessageStore? messageStore;

    // Map field name → input id
    private readonly Dictionary<string, string> fieldIdMap = new()
    {
        { "FullName",      "fullName" },
        { "Email",         "email" },
        { "Phone",         "phone" },
        { "Address",       "address" },
        { "Message",       "message" },
        { "Service",       "service" },
        { "TermsAccepted", "terms" },
    };

    protected override void OnInitialized()
    {
        editContext = new EditContext(regisModel);
    }

    private string GetFieldClass(string fieldName)
    {
        if (editContext is null) return string.Empty;

        var field = editContext.Field(fieldName);
        if (!editContext.IsModified(field)) return string.Empty;

        return editContext.GetValidationMessages(field).Any()
            ? "is-invalid"
            : "is-valid";
    }

    private async Task HandleInvalidSubmit(EditContext context)
    {
        await Task.Delay(50);

        foreach (var (fieldName, inputId) in fieldIdMap)
        {
            var field = context.Field(fieldName);
            if (context.GetValidationMessages(field).Any())
            {
                await JS.InvokeVoidAsync("focusElement", inputId);
                break;
            }
        }
    }

    private void HandleValidSubmit()
    {
        // TODO: xử lý submit thành công
        Console.WriteLine("Form hợp lệ, tiến hành submit...");
    }
}