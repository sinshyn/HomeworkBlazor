<!-- Withdraw Modal -->
<div class="modal fade" id="transactionModal" tabindex="-1" aria-labelledby="transactionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="transactionModalLabel">
                    @transaction.Type
                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body">

                <div class="mb-3">
                    <label for="withdrawAmount" class="form-label fw-semibold">
                        Amount
                    </label>

                    <div class="input-group">
                        <input type="number" @bind=transaction.Amount class="form-control" id="withdrawAmount"
                               placeholder="Enter amount" min="1">

                        <span class="input-group-text">
                            USD
                        </span>
                    </div>
                </div>

            </div>

            <!-- Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button" class="btn btn-danger">
                    @transaction.Type
                </button>
            </div>

        </div>
    </div>
</div>



@code {
    [Parameter]
    public TransactionVM? transaction { get; set; }
}