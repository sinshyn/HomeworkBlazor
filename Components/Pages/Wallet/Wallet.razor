@page "/my-wallet"
@inject IJSRuntime JS
<PageTitle>My Wallet</PageTitle>

<div class="container bg-black p-5">
    <div class="text-center">
        <h1 class="text-white">
            My Wallet
        </h1>
        <h2 class="text-warning fw-bold my-3">
            $@balance
        </h2>
        <Deposit OnDeposit="() => ShowModalTrans(TransType.Deposit)" />
        <Withdraw OnWithdraw="() => ShowModalTrans(TransType.Withdraw)" />

        <History transactions="lstTrans" />
    </div>
    
 
    <ModalWallet transaction="tran" OnConfirm="ConfirmRequest" />
</div>


@code {
    private decimal balance { get; set; } = 0;
    private List<TransactionVM> lstTrans = new();
    public TransactionVM tran = new TransactionVM();
    


    //show modal
    public async Task ShowModalTrans(TransType kind)
    {
        Console.WriteLine(kind);
        tran = new TransactionVM
        {
            TypeTrans = kind
        };
        StateHasChanged(); // đảm bảo modal render dữ liệu mới TRƯỚC khi show
        await JS.InvokeVoidAsync("showTransactionModal");
    }

    //check số tiền
    public bool CheckDecimal(string input, out decimal result)
    {
        bool isDecimal = decimal.TryParse(input, out result);
        return isDecimal && result > 0;
    }


    //xử lý nạp/rút tiền
    private async Task ConfirmRequest(TransactionVM request)
    {
        bool isValid = CheckDecimal(request.Amount, out decimal amount);
        if (!isValid)
        {
            await JS.InvokeVoidAsync("showAlert", "Lỗi", "Số tiền không hợp lệ", "error");
            return;
        }
        if (request.TypeTrans == TransType.Withdraw && amount > balance)
        {
            await JS.InvokeVoidAsync("showAlert", "Lỗi", "Số dư không đủ", "error");
            return;
        }

        bool confirmed = await JS.InvokeAsync<bool>("showConfirm", "Xác nhận",
            request.TypeTrans == TransType.Deposit
                ? $"Nạp {amount:N0}đ vào ví?"
                : $"Rút {amount:N0}đ từ ví?");

        if (!confirmed) return;

       
        balance += request.TypeTrans == TransType.Deposit ? amount : -amount;

        lstTrans.Add(new TransactionVM
        {
            TypeTrans = request.TypeTrans,
            Amount = amount.ToString(),
            Time = DateTime.Now,
        });

        await JS.InvokeVoidAsync("showAlert", "Thành công",
            request.TypeTrans == TransType.Deposit ? "Nạp tiền thành công!" : "Rút tiền thành công!",
            "success");
        await JS.InvokeVoidAsync("hideTransactionModal");
        StateHasChanged();
    
    }
}





