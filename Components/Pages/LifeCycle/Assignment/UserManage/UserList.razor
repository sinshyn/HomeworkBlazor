@using homework.Models.DTOS.UserDtos
<style>
    .table-wrap {
        overflow-x: auto;
    }

    table {
        border-collapse: collapse;
        width: 100%;
        font-size: 14px;
    }

    th,
    td {
        border: 1px solid #ddd;
        padding: 8px 10px;
        text-align: left;
        white-space: nowrap;
    }

    thead th {
        background: #f3f4f6;
    }

    tbody tr:nth-child(even) {
        background: #fafafa;
    }

    tbody tr:hover {
        background: #eef6ff;
    }

    .group {
        text-align: center;
        background: #e5e7eb;
    }
</style>

<div class="card my-4">
    <div class="card-header fw-bold">
        <h2>Danh sách người dùng</h2>
    </div>
    @if (Users != null && Users.Any())
    {
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Họ tên</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Điện thoại</th>
                            <th>Website</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Users)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td>@user.FullName</td>
                                <td>@user.Username</td>
                                <td>@user.Email</td>
                                <td>@user.Phone</td>
                                <td>@user.Website</td>
                                <td>
                                    <button @onclick="() => EditUserAsync(user)" type="button"
                                            class="btn btn-warning rounded-pill w-50">Sửa</button>
                                    <button @onclick="() => DeleteUserAsync(user.Id)" type="button" class="btn btn-danger rounded-pill w-50">Xóa</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div>Chưa có dữ liệu....</div>
    }
</div>

@code {
    [Parameter]
    public List<UserDto>? Users { get; set; }

    [Parameter]
    public EventCallback<UserDto> EditUser { get; set; }
    private async Task EditUserAsync(UserDto info)
    {
        await EditUser.InvokeAsync(info);
    }

    [Parameter]
    public EventCallback<int> DeleteUser { get; set; }
    private async Task DeleteUserAsync(int id)
    {
        await DeleteUser.InvokeAsync(id);
    }
}