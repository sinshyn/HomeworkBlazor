@page "/form/customer-contact-form"
@inject IJSRuntime JS

<PageTitle>Customer Contact Form</PageTitle>

<div class="container">
    <div class="mx-auto py-4 bg-info-subtle">
        <div class="row">
            <div class="col-8">
                <h1 class="text-center">Customer Contact Form</h1>
                <EditForm EditContext="@editContext" class="px-5 row g-3" OnValidSubmit="HandleValidSubmit"
                          OnInvalidSubmit="HandleInvalidSubmit">
                    <DataAnnotationsValidator />
                    <div class="col-md-12">
                        <label for="fullName" class="form-label">Full Name *</label>
                        <input @bind="@contactModel.FullName" @bind:event="oninput" type="text"
                               class="form-control @(GetFieldClass("FullName"))" id="fullName"
                               placeholder="Enter your full name" />
                        <ValidationMessage For="@(() => contactModel.FullName)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <label for="email" class="form-label">Email *</label>
                        <input @bind="@contactModel.Email" @bind:event="oninput" type="email"
                               class="form-control @(GetFieldClass("Email"))" id="email" placeholder="Enter your email" />
                        <ValidationMessage For="@(() => contactModel.Email)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <label for="phone" class="form-label">Phone Number *</label>
                        <input @bind="@contactModel.Phone" @bind:event="oninput" type="tel"
                               class="form-control @(GetFieldClass("Phone"))" id="phone"
                               placeholder="Enter your phone number" />
                        <ValidationMessage For="@(() => contactModel.Phone)" class="text-danger small" />
                    </div>
                    <div class="col-md-12">
                        <label for="address" class="form-label">Address</label>
                        <input @bind="@contactModel.Address" @bind:event="oninput" type="text"
                               class="form-control @(GetFieldClass("Address"))" id="address"
                               placeholder="Enter your address" />
                        <ValidationMessage For="@(() => contactModel.Address)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <label for="message" class="form-label">Message *</label>
                        <textarea @bind="@contactModel.Message" @bind:event="oninput"
                                  class="form-control @(GetFieldClass("Message"))" id="message" rows="5"
                                  placeholder="Enter your message"></textarea>
                        <ValidationMessage For="@(() => contactModel.Message)" class="text-danger small" />
                    </div>
                    <div class="col-md-12">
                        <label for="service" class="form-label">Select Service *</label>
                        <select @bind="@contactModel.Service" class="form-select @(GetFieldClass("Service"))"
                                id="service">
                            <option value="">Chọn dịch vụ</option>
                            @foreach (var service in serviceOptions)
                            {
                                <option value="@service.Value">@service.Label</option>
                            }
                        </select>
                        <ValidationMessage For="@(() => contactModel.Service)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <div class="form-check">
                            <input @bind="contactModel.TermsAccepted"
                                   class="form-check-input @(GetFieldClass("TermsAccepted"))" type="checkbox" id="terms" />
                            <label class="form-check-label" for="terms">
                                I accept the Terms and Conditions *
                            </label>
                        </div>
                        <ValidationMessage For="@(() => contactModel.TermsAccepted)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                </EditForm>
            </div>

            <div class="col-4">
                <h2>Thông tin ghi nhận</h2>
                <p>Họ tên: @contactModel.FullName</p>
                <p>Email: @contactModel.Email</p>
                <p>Số điện thoại: @contactModel.Phone</p>
                <p>Địa chỉ: @contactModel.Address</p>
                <p>Dịch vụ: @contactModel.Service</p>
                <p>Lời nhắn: @contactModel.Message</p>
                <p>Đồng ý điều khoản: @(contactModel.TermsAccepted ? "✅ Có" : "❌ Chưa")</p>
            </div>
        </div>
    </div>
</div>

@code {
    private ContactVM contactModel = new ContactVM();
    private EditContext? editContext;
    private ValidationMessageStore? messageStore;


    public class ServiceOption
    {
        public string Value { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
    }

    private List<ServiceOption> serviceOptions = new()
{
    new() { Value = "MuaSam", Label = "Mua sắm" },
    new() { Value = "DiAn", Label = "Đi ăn" },
    new() { Value = "DuLich", Label = "Du lịch" },
    new() { Value = "DatPhong", Label = "Đặt phòng" },
    new() { Value = "DatXe", Label = "Đặt xe" },
    new() { Value = "ThueXeTuLai", Label = "Thuê xe tự lái" },
};

    
    // Map field name → input id
    private readonly Dictionary<string, string> fieldIdMap = new()
    {
        { "FullName", "fullName" },
        { "Email", "email" },
        { "Phone", "phone" },
        { "Address", "address" },
        { "Message", "message" },
        { "Service", "service" },
        { "TermsAccepted", "terms" },
    };

    protected override void OnInitialized()
    {
        editContext = new EditContext(contactModel);
    }

    private string GetFieldClass(string fieldName)
    {
        if (editContext is null) return string.Empty;

        var field = editContext.Field(fieldName);
        if (!editContext.IsModified(field)) return string.Empty;

        return editContext.GetValidationMessages(field).Any()
            ? "is-invalid"
            : "is-valid";
    }

    private async Task HandleInvalidSubmit(EditContext context)
    {
        await Task.Delay(50);

        foreach (var (fieldName, inputId) in fieldIdMap)
        {
            var field = context.Field(fieldName);
            if (context.GetValidationMessages(field).Any())
            {
                await JS.InvokeVoidAsync("focusElement", inputId);
                break;
            }
        }
    }

    private void HandleValidSubmit()
    {
        // TODO: xử lý submit thành công
        Console.WriteLine("Form hợp lệ, tiến hành submit...");
    }
}