<h3 class="mt-5">List Cart (@giohang.Count)</h3>
<table class="table ">
    <tr>
        <th>STT</th>
        <th>Image</th>
        <th>Name</th>
        <th>Quantity</th>
        <th>Price</th>
        <th>Total</th>
        <th>Action</th>
    </tr>

    @for (int i = 0; i < giohang.Count; i++)
    {
        var item = giohang[i];
        <tr>
            <td>@(i + 1)</td>
            <td>
                <img src="@item.Img" alt="" style="width: 150px; height: 100px;">
            </td>
            <td>@item.Name</td>
            <td>
                <button class="btn btn-warning" @onclick="() => OnQuantityChangedAsync(item, -1)">
                    -
                </button>
                @item.Quantity
                <button class="btn btn-success" @onclick="() => OnQuantityChangedAsync(item, +1)">
                    +
                </button>
            </td>
            <td>@item.Price</td>
            <td>@item.Total</td>
            <td><button class="btn btn-danger" @onclick="() => OnRemoveAsync(item)">delete</button></td>

        </tr>
    }
</table>

@code {
    [Parameter]
    public List<CarVM> giohang { get; set; }

    [Parameter]
    public EventCallback<(CarVM item, int num)> OnQuantityChanged { get; set; }
    private async Task OnQuantityChangedAsync(CarVM item, int num)
    {
        await OnQuantityChanged.InvokeAsync((item, num));
    }

    [Parameter]
    public EventCallback<CarVM> OnRemove { get; set; }
    private async Task OnRemoveAsync(CarVM item)
    {
        await OnRemove.InvokeAsync(item);
    }
    
}