@using System.Text.Json
@using homework.Models.DTOS.UserDtos

<style>
    /* Sai và không focus: viền đỏ */
    .form-control.invalid {
        border-color: #dc3545;
    }

    /* Đang focus (đang nhập): về màu focus bình thường của Bootstrap */
    .form-control.invalid:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 .25rem rgba(13, 110, 253, .25);
    }

    /* Thông báo lỗi màu đỏ */
    .validation-message {
        color: #dc3545;
        font-size: .875rem;
        margin-top: .25rem;
    }

    /* Đang focus vào ô thì ẩn thông báo lỗi ngay sau nó */
    .form-control:focus~.validation-message {
        display: none;
    }
</style>

<EditForm Model="formModel" OnValidSubmit="AddUserAsync">
    <DataAnnotationsValidator />
    <div class="card my-4">
        <div class="card-header fw-bold">
            <h2> form người dùng</h2>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="name" class="form-label">Họ Tên <span class="text-danger">*</span></label>
                    <InputText @bind-Value="formModel.FullName" type="text" class="form-control" id="name"
                               placeholder="Leanne Graham" />
                    <ValidationMessage For="@(() => formModel.FullName)" />
                </div>
                <div class="col-md-6">
                    <label for="username" class="form-label">Username <span class="text-danger">*</span></label>
                    <InputText @bind-Value="formModel.Username" type="text" class="form-control" id="username"
                               placeholder="Bret" />
                    <ValidationMessage For="@(() => formModel.Username)" />
                </div>
                <div class="col-md-6">
                    <label for="email" class="form-label">Email <span class="text-danger">*</span></label>
                    <InputText @bind-Value="formModel.Email" type="email" class="form-control" id="email"
                               placeholder="example@mail.com" />
                    <ValidationMessage For="@(() => formModel.Email)" />
                </div>
                <div class="col-md-6">
                    <label for="phone" class="form-label">Điện thoại <span class="text-danger">*</span></label>
                    <InputText @bind-Value="formModel.Phone" type="tel" class="form-control" id="phone"
                               placeholder="1-770-736-8031" />
                    <ValidationMessage For="@(() => formModel.Phone)" />
                </div>
                <div class="col-12">
                    <label for="website" class="form-label">Website <span class="text-danger">*</span></label>
                    <InputText @bind-Value="formModel.Website" type="text" class="form-control" id="website"
                               placeholder="hildegard.org" />
                    <ValidationMessage For="@(() => formModel.Website)" />
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 ">
        <button @onclick="ResetForm" type="reset" class="btn btn-warning rounded-pill px-3">Làm mới</button>
        <button type="submit" class="btn btn-success rounded-pill px-3 fw-bold">Lưu</button>
    </div>
  

    
</EditForm>

@code {
    private UserDto formModel = new UserDto();

    //hàm nhận từ cha
    [Parameter]
    public EventCallback<UserDto> AddUser { get; set; }

    [Parameter]
    public UserDto? UserInfo { get; set; }

    //id cũ để quyết định có nên render lại giao diện không
    private int currentId;


    //hàm chung gian để gọi
    //gọi hàm khi các field trong form thỏa điều kiện => gọi ngay EditForm
    private async Task AddUserAsync()
    {
        Console.WriteLine("Thêm User thành công");
        await AddUser.InvokeAsync(formModel);
        Console.WriteLine("Data form" + JsonSerializer.Serialize(formModel));
        ResetForm();
    }

    //hàm reset form
    private void ResetForm()
    {
        formModel = new UserDto();
    }

    //cập nhật thông tin của user vào form
    protected override void OnParametersSet()
    {
        Console.WriteLine("[OnParametersSet] UserInfo = " + JsonSerializer.Serialize(UserInfo));
        if (UserInfo != null && UserInfo.Id != currentId)
        {
            formModel = new UserDto()
            {
                Id = UserInfo.Id,
                FullName = UserInfo.FullName,
                Username = UserInfo.Username,
                Phone = UserInfo.Phone,
                Email = UserInfo.Email,
                Website = UserInfo.Website,
            };
            currentId = UserInfo.Id;
        }
    }

    @* protected override bool ShouldRender()
    {
        if (UserInfo != null && UserInfo.Id != currentId)
        {
            return true;
        }
        return false;
        
    } *@

}