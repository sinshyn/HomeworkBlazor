@page "/form/course-registration-form"
@inject IJSRuntime JS

<PageTitle>Course Registration Form</PageTitle>

<div class="container">
    <div class="mx-auto py-4 bg-info-subtle">
        <div class="row">
            <div class="col-8">
                <h1 class="text-center">Course Registration Form</h1>
                <EditForm EditContext="@editContext" class="px-5 row g-3" OnValidSubmit="HandleValidSubmit"
                          OnInvalidSubmit="HandleInvalidSubmit">
                    <DataAnnotationsValidator />

                    <div class="col-md-12">
                        <label for="fullName" class="form-label">Full Name *</label>
                        <input @bind="@regisModel.FullName" @bind:event="oninput" type="text"
                               class="form-control @(GetFieldClass("FullName"))" id="fullName"
                               placeholder="Enter your full name" />
                        <ValidationMessage For="@(() => regisModel.FullName)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <label for="email" class="form-label">Email *</label>
                        <input @bind="@regisModel.Email" @bind:event="oninput" type="email"
                               class="form-control @(GetFieldClass("Email"))" id="email" placeholder="Enter your email" />
                        <ValidationMessage For="@(() => regisModel.Email)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <label for="phone" class="form-label">Phone Number *</label>
                        <input @bind="@regisModel.Phone" @bind:event="oninput" type="tel"
                               class="form-control @(GetFieldClass("Phone"))" id="phone"
                               placeholder="Enter your phone number" />
                        <ValidationMessage For="@(() => regisModel.Phone)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <label for="course" class="form-label">Select Course *</label>
                        <select @bind="@regisModel.Course" class="form-select @(GetFieldClass("Course"))">
                            <option value="">Chọn khóa học</option>
                            @foreach (var course in courseOptions)
                            {
                                <option value="@course.Value">@course.Label</option>
                            }
                        </select>
                        <ValidationMessage For="@(() => regisModel.Course)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label d-block">Study Mode *</label>

                        <InputRadioGroup @bind-Value="regisModel.StudyMode" Name="studymode">
                            <div class="form-check form-check-inline">
                                <InputRadio Value="@("Online")" class="form-check-input" id="studyModeOnline" />
                                <label class="form-check-label" for="studyModeOnline">Online</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <InputRadio Value="@("Offline")" class="form-check-input" id="studyModeOffline" />
                                <label class="form-check-label" for="studyModeOffline">Offline</label>
                            </div>
                        </InputRadioGroup>
                        <ValidationMessage For="@(() => regisModel.StudyMode)" class="text-danger small" />
                    </div>
                    <div class="col-md-12">
                        <label for="datePick" class="form-label">Ngày bắt đầu học *</label>
                        <input @bind="@regisModel.DatePick" @bind:event="onchange" type="date"
                               class="form-control @(GetFieldClass("DatePick"))" id="datePick"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <ValidationMessage For="@(() => regisModel.DatePick)" class="text-danger small" />
                    </div>


                    <div class="col-md-12">
                        <label for="notes" class="form-label">Comment or Notes *</label>
                        <textarea @bind="@regisModel.Notes" @bind:event="oninput"
                                  class="form-control @(GetFieldClass("Notes"))" id="notes" rows="5"
                                  placeholder="Enter your notes"></textarea>
                        <ValidationMessage For="@(() => regisModel.Notes)" class="text-danger small" />
                    </div>

                    

                    <div class="col-md-12">
                        <div class="form-check">
                            <input @bind="regisModel.TermsAccepted"
                                   class="form-check-input @(GetFieldClass("TermsAccepted"))" type="checkbox" id="terms" />
                            <label class="form-check-label" for="terms">
                                I accept the Terms and Conditions *
                            </label>
                        </div>
                        <ValidationMessage For="@(() => regisModel.TermsAccepted)" class="text-danger small" />
                    </div>

                    <div class="col-md-12">
                        <button type="submit" class="btn btn-primary w-100 bg-success">Register</button>
                    </div>
                </EditForm>
            </div>

            <div class="col-4">
                <h2>Thông tin ghi nhận</h2>
                <p>Họ tên: @regisModel.FullName</p>
                <p>Email: @regisModel.Email</p>
                <p>Số điện thoại: @regisModel.Phone</p>
                <p>Khóa học: @regisModel.Course</p>
                <p>hình thức học: @regisModel.StudyMode</p>
                <p>Ngày bắt đầu học: @(regisModel.DatePick?.ToString("dd/MM/yyyy") ?? "Chưa chọn")</p>
                <p>Lời nhắn: @regisModel.Notes</p>
                <p>Đồng ý điều khoản: @(regisModel.TermsAccepted ? "✅ Có" : "❌ Chưa")</p>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterVM regisModel = new RegisterVM();
    private EditContext? editContext;
    private ValidationMessageStore? messageStore;


    public class CourseOption
    {
        public string Value { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
    }

    private List<CourseOption> courseOptions = new()
{
    new() { Value = "BanHangOnline", Label = "Bán hàng online" },
    new() { Value = "CNTT", Label = "Công nghệ thông tin" },
    new() { Value = "DuLich", Label = "Du lịch" },
    new() { Value = "Dien", Label = "Điện" },
    new() { Value = "ThietKeDoHoa", Label = "Thiết kế đồ họa" },
};



    // Map field name → input id
    private readonly Dictionary<string, string> fieldIdMap = new()
    {
        { "FullName", "fullName" },
        { "Email", "email" },
        { "Phone", "phone" },
        { "Address", "address" },
        { "Notes", "notes" },
        { "Course", "course" },
        { "TermsAccepted", "terms" },
    };

    protected override void OnInitialized()
    {
        editContext = new EditContext(regisModel);
    }

    private string GetFieldClass(string fieldName)
    {
        if (editContext is null) return string.Empty;

        var field = editContext.Field(fieldName);
        if (!editContext.IsModified(field)) return string.Empty;

        return editContext.GetValidationMessages(field).Any()
            ? "is-invalid"
            : "is-valid";
    }

    private async Task HandleInvalidSubmit(EditContext context)
    {
        await Task.Delay(50);

        foreach (var (fieldName, inputId) in fieldIdMap)
        {
            var field = context.Field(fieldName);
            if (context.GetValidationMessages(field).Any())
            {
                await JS.InvokeVoidAsync("focusElement", inputId);
                break;
            }
        }
    }

    private void HandleValidSubmit()
    {
        // TODO: xử lý submit thành công
        Console.WriteLine("Form hợp lệ, tiến hành submit...");
    }
}